# ---- Secrets ----
.env
.env.local
*.pem
kaggle.json

# ---- Virtual environment ----
.venv/
venv/
env/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Data: heavy + regenerable ----
# raw/ holds twcs.csv (~500MB) - downloaded via scripts/download_data.py
data/raw/
# interim/ holds embedding caches and parquet intermediates - regenerable
data/interim/
# processed/ holds the seeded brand subsample. NOT redistributed: it is a
# derivative of the Kaggle "Customer Support on Twitter" dataset, which is
# CC BY-NC-SA 4.0. Rebuild it locally with:
#     python tasks.py data && python tasks.py subsample
# (deterministic from SEED, so every run produces the identical file).
data/processed/*.parquet
# subsample_meta.json IS committed - it is counts and provenance, not tweet
# content, and the report quotes it.

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- OS / editor ----
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# ---- Planning docs (per user request) ----
# WARNING: docs/decision_log.md and docs/report.md are graded deliverables of the
# assignment. Ignoring docs/ keeps them off GitHub. To ship them to evaluators,
# delete the line below (or see README for the selective alternative).
docs

# ---- sqlite sidecars ----
# The cache DB itself IS committed (D10), but WAL/SHM are transient per-process
# state and committing them would produce spurious diffs on every run.
*.sqlite-wal
*.sqlite-shm
