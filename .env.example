# ThreadPilot — environment template.
#
#   cp .env.example .env      (then fill in the values below)
#
# .env is gitignored. Never commit real values. Never paste a token into a chat
# window or an issue — if you do, treat it as compromised and rotate it.

# --- Groq (free tier) — required for LIVE runs, NOT for offline replay --------
# Get one at https://console.groq.com/keys
# Not needed if you only run:  python tasks.py eval --offline
GROQ_API_KEY=gsk_your_key_here

# --- Kaggle — required only to download the raw dataset ----------------------
# OPTIONAL. Preferred setup is the token FILE, not this variable:
#   ~/.kaggle/access_token   containing a single KGAT_... token
# (Get it from https://www.kaggle.com/settings/api -> "Generate New Token".)
#
# Set this only if you would rather keep the token in .env than in your home
# directory. The token file takes precedence if both exist.
# Note: `kaggle.json` with KAGGLE_USERNAME/KAGGLE_KEY is Kaggle's LEGACY scheme;
# it still works, but the single-token form below is current. See D16.
# KAGGLE_API_TOKEN=KGAT_your_token_here

# --- Optional overrides -------------------------------------------------------
# Model used for generation (classification, drafting, decisions).
# THREADPILOT_GEN_MODEL=openai/gpt-oss-120b
#
# Model used by the LLM judge. MUST be a different family than the generator -
# see decision_log.md D7/D19 (self-preference bias).
# THREADPILOT_JUDGE_MODEL=qwen/qwen3.8-27b
